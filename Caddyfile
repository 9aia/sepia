# Serves the sepia UI and proxies /api to the API service, injecting the bearer
# token so it never reaches the client. Put TLS in front of this (Caddy
# automatic HTTPS on a real domain, or your existing reverse proxy).
:80 {
	handle /api/* {
		reverse_proxy api:8787 {
			header_up Authorization "Bearer {$SEPIA_TOKEN}"
		}
	}

	handle {
		reverse_proxy web:3000
	}
}

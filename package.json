{
  "name": "sepia-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run docs:gen && vitepress dev",
    "build": "bun run docs:gen && vitepress build",
    "preview": "vitepress preview",
    "docs:dev": "bun run docs:gen && vitepress dev",
    "docs:gen": "bun run docs:cli && bun run docs:crates",
    "docs:check": "bun run docs:gen && git diff --exit-code",
    "docs:cli": "cypera gen cli --repo ..",
    "docs:crates": "cypera gen crate-map --repo ..",
    "docs:deploy": "bun run build && bunx gh-pages -d .vitepress/dist"
  },
  "devDependencies": {
    "vitepress": "^1.6.0",
    "gh-pages": "^6.3.0",
    "vitepress-theme-9aia": "github:9aia/vitepress-theme-9aia#5e07954bb6db86ede9fccabdbdb2aa8681d1053e"
  }
}

{
  "name": "sepia-node",
  "version": "0.0.0",
  "description": "Sepia node + CLI — serve coding-agent sessions (Devin, Cline, Claude Code, Cursor) over the Sepia protocol; embeds the web UI.",
  "keywords": [
    "acp",
    "ag-ui",
    "claude-code",
    "cline",
    "coding-agent",
    "cursor",
    "devin",
    "sessions"
  ],
  "homepage": "https://github.com/9aia/sepia",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/9aia/sepia.git",
    "directory": "packages/sepia-node"
  },
  "bin": {
    "sepia": "bin/sepia.js"
  },
  "files": [
    "bin",
    "dist",
    "ui"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "bun ../../tools/build-npm.ts --only sepia-node --skip-web-build"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
